<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane prefHeight="550.0" prefWidth="750.0" style="-fx-background-color: #282828;"
            stylesheets="@styles.css"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.controller.MainController">
    <children>
        <VBox spacing="18.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0"
              AnchorPane.topAnchor="20.0">
            <children>

                <Label text="Gerenciador de Distros Linux" textFill="WHITE">
                    <font>
                        <Font name="Segoe UI Bold" size="22.0"/>
                    </font>
                </Label>

                <ImageView fitWidth="65.0" fitHeight="65.0" preserveRatio="true" pickOnBounds="true" viewOrder="-1.0" translateX="24">
                    <image>
                        <Image url="@assets/like.png"/>
                    </image>
                </ImageView>

                <TableView fx:id="tblDistro" onMouseClicked="#loadField" prefHeight="260.0" prefWidth="643.0" translateY="-33.1" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" minWidth="50.0" prefWidth="60.0" text="ID"/>
                        <TableColumn fx:id="colName" minWidth="100.0" prefWidth="160.0" text="Nome"/>
                        <TableColumn fx:id="colBase" minWidth="100.0" prefWidth="160.0" text="Base"/>
                        <TableColumn fx:id="colPackageManager" minWidth="100.0" prefWidth="160.0" text="Gerenciador"/>
                        <TableColumn fx:id="colEnvironment" minWidth="100.0" prefWidth="160.0" text="Interface"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" spacing="15.0">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Nome da Distro *" textFill="#DCDCDC">
                                    <font>
                                        <Font name="Segoe UI" size="13.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtName" onKeyTyped="#checkForm" promptText="Ex: Ubuntu"
                                           prefHeight="33.0"/>
                            </children>
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Base" textFill="#DCDCDC">
                                    <font>
                                        <Font name="Segoe UI" size="13.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtBase" onKeyTyped="#checkForm" promptText="Ex: Debian"
                                           prefHeight="33.0"/>
                            </children>
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Gerenciador *" textFill="#DCDCDC">
                                    <font>
                                        <Font name="Segoe UI" size="13.0"/>
                                    </font>
                                </Label>
                                <TextField fx:id="txtPkgMng" onKeyTyped="#checkForm" promptText="Ex: apt"
                                           prefHeight="33.0"/>
                            </children>
                        </VBox>

                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Interface *" textFill="#DCDCDC">
                                    <font>
                                        <Font name="Segoe UI" size="13.0"/>
                                    </font>
                                </Label>
                                <ComboBox fx:id="comboEnvironment" editable="true" maxWidth="Infinity"
                                          onAction="#checkForm" promptText="Ex: GNOME" prefHeight="33.0"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">
                    <children>
                        <Button fx:id="btnClear" mnemonicParsing="false" onAction="#btnClearAction"
                                style="-fx-background-color: #31c3e0;"
                                text="Limpar"/>

                        <ImageView fitWidth="40.0" fitHeight="40.0" preserveRatio="true" pickOnBounds="true">
                            <image>
                                <Image url="@assets/Tux.png"/>
                            </image>
                        </ImageView>
                        <Region HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btnRegister" mnemonicParsing="false" onAction="#btnRegisterAction"
                                style="-fx-background-color: #34e070;"
                                text="Adicionar"/>

                        <Button fx:id="btnUpdate" mnemonicParsing="false" onAction="#btnUpdateAction"
                                style="-fx-background-color: #ff722b;"
                                text="Atualizar"/>

                        <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#btnDeleteAction"
                                style="-fx-background-color: #ff2b4b;"
                                text="Excluir"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>